# ==============================================================================
# HỆ THỐNG QUẢN LÝ KHO HÀNG NHIỀU CHI NHÁNH
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# 1. Spring Boot Server Port
SERVER_PORT=8080

# 2. Cấu hình Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# 3. Cấu hình Security & JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRATION=86400000

# 4. Tài khoản Admin mặc định
DEFAULT_ADMIN_USERNAME=your_admin_username
DEFAULT_ADMIN_PASSWORD=your_admin_password

# 5. Cấu hình gửi mail (SMTP Gmail)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# 6. Backup HMAC Secret
BACKUP_SECRET=your_backup_hmac_secret_key

# 7. AbstractAPI Email Verification Key
ABSTRACT_API_KEY=your_abstract_api_key
