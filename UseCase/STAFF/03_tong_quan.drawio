          <mxGeometry x="30" y="200" width="160" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Included Use Cases -->
        <mxCell id="uc_kpi" value="Xem các chỉ số KPI&#xa;(Giá trị kho, KH, AR...)" vertex="1" parent="sys" 
